#!/usr/bin/env python3
"""obsctl: 관측 스택(Prometheus, Loki, Tempo)을 HTTP 로 조회하는 CLI.

Claude Code 같은 에이전트가 장애 원인을 찾을 때 쓰라고 만든 도구다.
표준 라이브러리만 쓰므로 설치가 필요 없다.

사용법:
  obsctl metrics '<promql>'          Prometheus 즉시 질의
  obsctl logs '<logql>' [분]         Loki 범위 질의 (기본 15분)
  obsctl traces <service> [분]       Tempo 트레이스 검색 (기본 15분)
  obsctl trace <traceId>             트레이스 하나를 span 트리로
  obsctl analyze <service> [분]      위 셋을 한 번에 (장애 분석 시작점)

환경변수로 주소를 바꿀 수 있다.
  PROM_URL   기본 http://prometheus.localhost
  LOKI_URL   기본 http://loki.localhost
  TEMPO_URL  기본 http://tempo.localhost
"""
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

PROM = os.environ.get("PROM_URL", "http://prometheus.localhost")
LOKI = os.environ.get("LOKI_URL", "http://loki.localhost")
TEMPO = os.environ.get("TEMPO_URL", "http://tempo.localhost")
TIMEOUT = 15


def get(url, params):
    full = f"{url}?{urllib.parse.urlencode(params)}"
    try:
        with urllib.request.urlopen(full, timeout=TIMEOUT) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"{e.code} {e.reason}\n  {full}")
    except urllib.error.URLError as e:
        die(f"접속 실패: {e.reason}\n  {full}\n  HTTPRoute 와 /etc/hosts 를 확인하세요.")


def die(msg):
    print(f"obsctl: {msg}", file=sys.stderr)
    sys.exit(1)


def minutes_arg(argv, idx, default=15):
    return int(argv[idx]) if len(argv) > idx else default


# ---------------------------------------------------------------- metrics
def cmd_metrics(argv):
    if not argv:
        die("PromQL 이 필요합니다.")
    d = get(f"{PROM}/api/v1/query", {"query": argv[0]})
    result = d.get("data", {}).get("result", [])
    if not result:
        print("(결과 없음)")
        return
    for s in result:
        labels = ", ".join(f"{k}={v}" for k, v in s["metric"].items() if k != "__name__")
        print(f"  {s['value'][1]:>12}  {labels}")


# ------------------------------------------------------------------- logs
def cmd_logs(argv):
    if not argv:
        die("LogQL 이 필요합니다.")
    mins = minutes_arg(argv, 1)
    now = int(time.time())
    d = get(f"{LOKI}/loki/api/v1/query_range", {
        "query": argv[0],
        "start": (now - mins * 60) * 10**9,
        "end": now * 10**9,
        "limit": 50,
        "direction": "backward",
    })
    streams = d.get("data", {}).get("result", [])
    if not streams:
        print("(로그 없음)")
        return
    lines = []
    for s in streams:
        for ts, line in s["values"]:
            lines.append((int(ts), line))
    for ts, line in sorted(lines, reverse=True)[:50]:
        stamp = time.strftime("%H:%M:%S", time.localtime(ts / 10**9))
        print(f"  {stamp}  {line.strip()[:200]}")


# ----------------------------------------------------------------- traces
def cmd_traces(argv):
    if not argv:
        die("서비스 이름이 필요합니다.")
    mins = minutes_arg(argv, 1)
    now = int(time.time())
    d = get(f"{TEMPO}/api/search", {
        "tags": f"service.name={argv[0]}",
        "start": now - mins * 60,
        "end": now,
        "limit": 20,
    })
    traces = d.get("traces", []) or []
    if not traces:
        print("(트레이스 없음)")
        return
    print(f"  {'traceID':34s} {'duration':>9s}  root")
    for t in sorted(traces, key=lambda x: x.get("durationMs", 0), reverse=True):
        print(f"  {t.get('traceID',''):34s} {t.get('durationMs',0):>7}ms  "
              f"{t.get('rootTraceName','')}")


def cmd_trace(argv):
    if not argv:
        die("traceId 가 필요합니다.")
    try:
        with urllib.request.urlopen(f"{TEMPO}/api/traces/{argv[0]}", timeout=TIMEOUT) as r:
            d = json.load(r)
    except urllib.error.URLError as e:
        die(f"트레이스 조회 실패: {e}")

    for batch in d.get("batches", []):
        svc = "?"
        for attr in batch.get("resource", {}).get("attributes", []):
            if attr.get("key") == "service.name":
                svc = attr["value"].get("stringValue", "?")
        for scope in batch.get("scopeSpans", []):
            for span in scope.get("spans", []):
                dur = (int(span.get("endTimeUnixNano", 0))
                       - int(span.get("startTimeUnixNano", 0))) // 10**6
                status = span.get("status", {}).get("code", "")
                mark = " ERROR" if status == "STATUS_CODE_ERROR" else ""
                print(f"  {dur:>6}ms  {svc}/{span.get('name','')}{mark}")
                for attr in span.get("attributes", []):
                    key = attr.get("key", "")
                    if key.startswith(("user.", "timeout.", "upstream.", "http.")):
                        val = next(iter(attr.get("value", {}).values()), "")
                        print(f"           {key}={val}")


# -------------------------------------------------------------- analyze
def cmd_analyze(argv):
    if not argv:
        die("서비스 이름이 필요합니다.")
    svc = argv[0]
    mins = minutes_arg(argv, 1)

    print(f"# 장애 분석: {svc} (최근 {mins}분)\n")

    print("## 1. 에러율 (메트릭)")
    cmd_metrics([
        f'sum(rate(http_server_requests_seconds_count{{service="{svc}",status=~"5.."}}[{mins}m]))'
        f' / sum(rate(http_server_requests_seconds_count{{service="{svc}"}}[{mins}m]))'
    ])

    print("\n## 2. 엔드포인트별 에러 수 (메트릭)")
    cmd_metrics([
        f'sum by (uri,status) (increase('
        f'http_server_requests_seconds_count{{service="{svc}",status=~"5.."}}[{mins}m]))'
    ])

    print("\n## 3. 느린 트레이스 (트레이스)")
    cmd_traces([svc, str(mins)])

    print("\n## 4. 최근 에러 로그 (로그)")
    cmd_logs([f'{{service_name="{svc}"}} |= "ERROR"', str(mins)])

    print("\n다음 단계: 위에서 가장 느린 traceID 를 골라 obsctl trace <traceId> 로 구간을 확인하세요.")


COMMANDS = {
    "metrics": cmd_metrics,
    "logs": cmd_logs,
    "traces": cmd_traces,
    "trace": cmd_trace,
    "analyze": cmd_analyze,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        die(f"알 수 없는 명령: {cmd}\n{__doc__}")
    COMMANDS[cmd](sys.argv[2:])


if __name__ == "__main__":
    main()
