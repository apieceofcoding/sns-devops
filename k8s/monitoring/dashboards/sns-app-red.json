          "expr": "100 * (sum by (method, uri)(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\", status=~\"5..\"}[5m])) or (0 * sum by (method, uri)(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m])))) / (sum by (method, uri)(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m])) > 0)",
          "editorMode": "code",
