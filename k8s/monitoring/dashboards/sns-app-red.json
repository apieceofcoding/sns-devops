{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "SNS 앱 메트릭을 수집하는 Prometheus를 선택하세요.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "id": null,
  "uid": "sns-app-red",
  "title": "SNS App RED",
  "description": "SNS 앱의 요청량, 5xx 오류율, 평균 응답 시간을 전체와 API별로 확인합니다. 최근 5분 기준이며 /actuator 요청은 제외해요. 수집 간격은 30초입니다.",
  "tags": [
    "sns-app",
    "RED",
    "part-5"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "전체 요청량",
      "description": "최근 5분의 평균 초당 요청 수입니다. /actuator 경로는 제외합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m]))",
          "editorMode": "code",
          "legendFormat": "요청량",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "전체 5xx 오류율",
      "description": "최근 5분 요청 중 HTTP 5xx의 비율입니다. 4xx는 포함하지 않아요. 요청이 없으면 비율을 표시하지 않습니다. /actuator 경로는 제외합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\", status=~\"5..\"}[5m])) or (0 * sum(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m])))) / (sum(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m])) > 0)",
          "editorMode": "code",
          "legendFormat": "5xx 오류율",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "전체 평균 응답 시간",
      "description": "최근 5분의 처리 시간 합계를 요청 수로 나눈 평균입니다. 요청이 없으면 표시하지 않아요. /actuator 경로는 제외합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1000 * sum(rate(http_server_requests_seconds_sum{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m])) / (sum(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m])) > 0)",
          "editorMode": "code",
          "legendFormat": "평균 응답 시간",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API별 요청량",
      "description": "최근 5분의 평균 초당 요청 수입니다. /actuator 경로는 제외합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (method, uri)(rate(http_server_requests_seconds_count{namespace=\"sns\", service=\"sns-app\", uri!~\"/actuator.*\"}[5m]))",
          "editorMode": "code",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API별 5xx 오류율",
      "description": "최근 5분 요청 중 HTTP 5xx의 비율입니다. 4xx는 포함하지 않아요. 요청이 없으면 비율을 표시하지 않습니다. /actuator 경로는 제외합니다.",
      "datasource": {
